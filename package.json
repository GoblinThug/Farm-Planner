{
  "name": "stardew-farm-planner",
  "version": "2.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "sync:assets": "node scripts/extract-asset-manifests.mjs && node scripts/verify-asset-registry.mjs && node scripts/verify-png-assets.mjs",
    "fetch:villagers": "node scripts/fetch-villager-portraits.mjs && npm run sync:assets",
    "import:portraits-cdp": "node scripts/import-portraits-cdp.mjs",
    "import:gift-icons-cdp": "node scripts/import-gift-icons-cdp.mjs",
    "gifts:missing-icons": "node scripts/list-missing-gift-icons.mjs",
    "fetch:gift-icons-fandom": "node scripts/fetch-gift-icons-fandom.mjs && npm run sync:assets"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.25",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
